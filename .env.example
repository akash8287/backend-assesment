# MongoDB connection string. The API fails startup if MongoDB is unreachable.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cohort_insights
MONGO_SERVER_SELECTION_MS=5000

# Redis holds the content cache and the per-user active-job set.
# If Redis is down the API still serves traffic: cache misses fall through
# to MongoDB, and admission falls back to a MongoDB count of active documents.
REDIS_URL=redis://localhost:6379/0

# Combined cap for documents in queued, processing, or enriching.
MAX_ACTIVE_JOBS_PER_USER=3
# How long an active-job lease survives if a worker never releases it.
ACTIVE_JOB_LEASE_SECONDS=180
# How long a per-user admission lock is held. Must cover one MongoDB write.
ADMISSION_LOCK_TTL_MS=10000
ADMISSION_LOCK_WAIT_SECONDS=0.5

# Content-hash cache TTL. The key is the hash, never the document id.
CACHE_TTL_SECONDS=86400

# Simulated stage durations. Defaults match the assignment.
PIPELINE_PROCESSING_MIN_SECONDS=10
PIPELINE_PROCESSING_MAX_SECONDS=20
PIPELINE_ENRICHING_MIN_SECONDS=5
PIPELINE_ENRICHING_MAX_SECONDS=15

# Independent failure probability for each stage attempt.
PIPELINE_PROCESSING_FAILURE_RATE=0.1
PIPELINE_ENRICHING_FAILURE_RATE=0.1

# Attempts per stage, including the first try. Backoff is exponential.
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_SECONDS=1
PIPELINE_POLL_INTERVAL_SECONDS=0.5

# A claim is stolen only after this lease. Keep it above the longest stage.
PIPELINE_CLAIM_LEASE_SECONDS=90
WORKER_CONCURRENCY=4
WORKER_ENABLED=true

LOG_LEVEL=INFO
